# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace_me

# Destination chat, group, or channel ID
TELEGRAM_CHAT_ID=

# Optional: forum topic/thread ID inside a group
TELEGRAM_TOPIC_ID=

# Optional: comma-separated Telegram user IDs allowed to run admin commands
TELEGRAM_ADMIN_IDS=

# Optional project settings
DRAGON_NEWS_REPOSITORY=chatdragon75-stack/Dragon-News
DRAGON_ART_REPOSITORY=chatdragon75-stack/Dragon-Art-Project
